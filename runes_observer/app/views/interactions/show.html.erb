<% content_for :title, "#{@id} — Runes Observatory" %>

<div class="page-head">
  <h1 class="mono"><%= @id %></h1>
  <span class="sub">
    request ·
    <%= @packets.size %> packets ·
    <%= @agents.size %> agent(s)
  </span>
  <%= link_to "← Packet log", packets_path(request_id: @id), class: "sub" %>
</div>

<% if @prompt.present? %>
  <div class="panel" style="margin-bottom:14px">
    <div class="panel__head"><span class="panel__title">Prompt</span></div>
    <div class="panel__body">
      <pre class="payload__body"><%= @prompt %></pre>
    </div>
  </div>
<% end %>

<% if @plan_chain[:links].any? { |l| %w[plan tool_call verdict].include?(l.kind) } %>
  <div class="panel" style="margin-bottom:14px">
    <div class="panel__head">
      <span class="panel__title">Plan chain</span>
      <span class="panel__count"><%= @plan_chain[:links].size %> links</span>
    </div>
    <div class="panel__body">
      <ol class="chain">
        <% @plan_chain[:links].each do |link| %>
          <li class="chain__link chain__link--<%= link.kind %>">
            <span class="badge badge--<%= link.kind %>"><%= link.kind %></span>
            <span class="mono"><%= link.label %></span>
            <% if link.packet %>
              <%= link_to "packet", packet_path(link.packet), class: "sub" %>
            <% end %>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
<% end %>

<div class="panel" style="margin-bottom:14px">
  <div class="panel__head">
    <span class="panel__title">Participants</span>
    <span class="panel__count"><%= @agents.size %></span>
  </div>
  <div class="panel__body">
    <% if @agents.empty? %>
      <span class="faint">No agent was attributed to this interaction.</span>
    <% else %>
      <% @agents.each do |agent_id| %>
        <%= link_to agent_id, agent_path(agent_id), class: "mono small" %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @timeline[:spans].any? %>
  <section class="panel" style="margin-bottom:14px">
    <div class="panel__head">
      <span class="panel__title">Where the time went</span>
      <span class="panel__count">
        total <%= WorkflowStep.duration_label(@timeline[:total_ms]) %>
        <% if @timeline[:dominant] %>
          · dominated by <span class="mono"><%= @timeline[:dominant].label %></span>
          (<%= WorkflowStep.duration_label(@timeline[:dominant].duration_ms) %>)
        <% end %>
      </span>
    </div>
    <div class="panel__body">
      <ol class="trace">
        <% @timeline[:spans].each do |span| %>
          <li class="trace__row">
            <span class="trace__idx mono"><%= span.index %></span>
            <span class="trace__label mono"><%= span.label %></span>
            <span class="trace__track">
              <span class="trace__gap <%= "trace__gap--dominant" if @timeline[:dominant] && span.index == @timeline[:dominant].index %>"
                    style="left: <%= span.percent %>%; width: <%= span.width_percent %>%"
                    title="<%= span.from_kind %><%= " · #{span.from_event}" if span.from_event.present? %> →
                           <%= span.label %>: <%= WorkflowStep.duration_label(span.duration_ms) %>"></span>
              <% @timeline[:markers].each do |marker| %>
                <% next unless marker.index == span.index %>
                <span class="trace__tick" style="left: <%= marker.offset_percent %>%"
                      title="<%= marker.label %> at <%= marker.at.strftime("%H:%M:%S.%L") %>"></span>
              <% end %>
            </span>
            <span class="trace__dur mono"><%= WorkflowStep.duration_label(span.duration_ms) %></span>
          </li>
        <% end %>
      </ol>
      <p class="faint small timeline__note">
        Each bar is the gap before a packet arrived, so the wait is drawn rather than
        implied: the longest bar is what the interaction actually spent its time on.
      </p>
    </div>
  </section>
<% end %>

<section class="panel">
  <div class="panel__head">
    <span class="panel__title">Timeline</span>
    <span class="panel__count">oldest first</span>
  </div>

  <% if @packets.empty? %>
    <div class="panel__empty">
      No packet carries this id.
      <%= link_to "See all packets", packets_path %> to find the interaction you are after.
    </div>
  <% else %>
    <%= render partial: "packets/packet", collection: @packets, as: :packet, locals: { show_agent: true } %>
  <% end %>
</section>
