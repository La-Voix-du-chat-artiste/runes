<% content_for :title, "Fleet — Runes Observatory" %>

<div class="page-head">
  <h1>Fleet</h1>
  <span class="sub">everything observed on <code>runes/#</code></span>
  <%= link_to "All agents →", agents_path, class: "sub" %>
</div>

<div class="stats">
  <div class="stat stat--online">
    <div class="stat__value"><%= @stats[:online] %></div>
    <div class="stat__label">running agents</div>
  </div>
  <div class="stat stat--ended">
    <div class="stat__value"><%= @stats[:ended] %></div>
    <div class="stat__label">ended agents</div>
  </div>
  <div class="stat stat--flow">
    <div class="stat__value"><%= @stats[:last_5m] %></div>
    <div class="stat__label">packets / 5 min</div>
  </div>
  <div class="stat">
    <div class="stat__value"><%= @stats[:total_packets] %></div>
    <div class="stat__label">packets observed</div>
  </div>
</div>

<% if @stats[:total_packets].zero? %>
  <div class="panel">
    <div class="empty">
      <h2>Nothing observed yet</h2>
      <p>Start the ingest process so the observatory can watch the fabric:</p>
      <p><code>bin/runes-ingest</code> &nbsp;·&nbsp; or generate a demo session with <code>bin/rails runes:demo</code></p>
      <p class="faint small">Publishing to <code>runes/#</code> on <%= @status.host %>:<%= @status.port %></p>
    </div>
  </div>
<% else %>
  <div class="grid grid--dash">
    <div class="grid">
      <section class="panel">
        <div class="panel__head">
          <span class="panel__title">Running</span>
          <span class="panel__count"><%= @stats[:online] %></span>
        </div>
        <%= render "agents/fleet", agents: @online, empty: "No agent is currently online." %>
      </section>

      <section class="panel">
        <div class="panel__head">
          <span class="panel__title">Ended</span>
          <span class="panel__count"><%= @stats[:ended] %></span>
        </div>
        <%= render "agents/fleet", agents: @ended, empty: "No agent has gone offline yet." %>
      </section>

      <section class="panel">
        <div class="panel__head">
          <span class="panel__title">Ingest</span>
          <span class="panel__count"><%= @status.display_state %></span>
        </div>
        <div class="panel__body">
          <dl class="kv">
            <dt>broker</dt><dd><%= @status.host %>:<%= @status.port %></dd>
            <dt>connected</dt><dd><%= @status.connected? ? "yes" : "no" %></dd>
            <dt>last packet</dt><dd><%= @status.last_message_at.present? ? "#{ago_in_words_short(@status.last_message_at)} ago" : "—" %></dd>
            <dt>packets this run</dt><dd><%= @status.packets_total %></dd>
            <% if @status.packets_dropped.to_i.positive? %>
              <dt>dropped</dt><dd><%= @status.packets_dropped %> (unstoreable)</dd>
            <% end %>
            <% if @status.last_error.present? %><dt>last error</dt><dd><%= @status.last_error %></dd><% end %>
          </dl>
          <% if @top_kinds.any? %>
            <div style="margin-top:10px">
              <% @top_kinds.each do |kind, count| %>
                <%= kind_badge(kind) %> <span class="faint small"><%= count %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    </div>

    <section class="panel">
    <div class="panel__head">
      <span class="panel__title">Traffic · last 30 min</span>
      <span class="panel__count"><%= @volume_total %> packet<%= "s" unless @volume_total == 1 %></span>
    </div>
    <div class="panel__body">
      <% peak = [@volume.map { |slot| slot[:count] }.max.to_i, 1].max %>
      <div class="spark" role="img" aria-label="Packets per minute over the last 30 minutes">
        <% @volume.each do |slot| %>
          <span class="spark__bar <%= "spark__bar--empty" if slot[:count].zero? %>"
                style="height: <%= [(slot[:count].to_f / peak * 100).round(1), slot[:count].zero? ? 2.0 : 6.0].max %>%"
                title="<%= slot[:at].strftime("%H:%M") %> · <%= slot[:count] %> packet<%= "s" unless slot[:count] == 1 %>"></span>
        <% end %>
      </div>
      <div class="spark__axis faint small">
        <span><%= @volume.first[:at].strftime("%H:%M") %></span>
        <span>peak <%= peak %>/min</span>
        <span>now</span>
      </div>

      <% if @kind_mix.any? %>
        <div class="kv__section">what it is carrying · last hour</div>
        <div class="mix">
          <% @kind_mix.each do |row| %>
            <div class="mix__row">
              <span class="badge badge--<%= row[:kind].tr("_", "-") %>"><%= row[:kind] %></span>
              <span class="mix__track"><span class="mix__bar" style="width: <%= row[:percent] %>%"></span></span>
              <span class="mix__num mono small"><%= row[:count] %> · <%= row[:percent] %>%</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="panel">
    <div class="panel__head">
      <span class="panel__title">Workflow runs</span>
      <span class="panel__count">
        <%= @run_stats[:total] %> total<% if @run_stats[:failed].positive? %> ·
          <span class="muted"><%= @run_stats[:failed] %> failed</span><% end %>
      </span>
    </div>
    <div class="panel__body panel__body--flush">
      <% if @runs.empty? %>
        <p class="panel__empty">
          No runs yet — publish some with
          <span class="mono">RUNES_TELEMETRY=mqtt bin/runes-workflow execute &lt;file&gt;</span>.
        </p>
      <% else %>
        <ul class="fleet">
          <% @runs.each do |run| %>
            <li class="fleet__item">
              <%= link_to run_path(run.run_id), class: "fleet__link" do %>
                <span class="pill pill--<%= run.status == 'ok' ? 'online' : (run.failed? ? 'offline' : 'connected') %>"><%= run.status %></span>
                <span>
                  <span class="fleet__name"><%= run.workflow_name %></span>
                  <span class="fleet__meta"><%= run.step_count %> steps · <%= run.duration_label %></span>
                </span>
                <span class="fleet__age"><%= run.started_at ? time_ago_in_words(run.started_at) + " ago" : "—" %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
        <p class="panel__body small"><%= link_to "All runs →", runs_path %></p>
      <% end %>
    </div>
  </section>

  <section class="panel"
             data-controller="feed"
             data-feed-url-value="<%= feed_path %>"
             data-feed-interval-value="2000">
      <div class="panel__head">
        <span class="panel__title">Live packets</span>
        <span class="panel__count">
          <span data-feed-target="count"><%= @stats[:total_packets] %></span> packets · newest first
        </span>
      </div>
      <div class="feed" data-feed-target="list" data-last-id="<%= @last_id %>">
        <%= render partial: "packets/packet", collection: @recent, as: :packet, locals: { show_agent: true } %>
      </div>
      <div class="panel__body">
        <%= link_to "Open the packet log →", packets_path, class: "small" %>
      </div>
    </section>
  </div>
<% end %>
