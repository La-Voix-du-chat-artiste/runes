#!/usr/bin/env ruby
# frozen_string_literal: true

# Generate a mosquitto `acl_file` from the Runes MQTT topic map.
#
#   bin/runes-acl --agent runes-a --agent runes-b
#   bin/runes-acl --agent runes-a --a2a --tool-rpc --allow-journal --out config/acl
#   bin/runes-acl --agent runes-a --print-topics
#
# What each agent gets (see docs/SECURITY.md):
#   read   runes/agents/+/card | status          fleet discovery
#   read   runes/agents/<id>/#  (+ tasks*)       its own card/status/tasks/replies
#   read   runes/prompts                         broadcast prompt (read-only)
#   read   $share/<group>/runes/prompts          shared-group broadcast subscribe
#   read   $share/<group>/runes/prompts         shared work queue (MQTT 5)
#   write  runes/agents/<id>/card | status       its own retained card + LWT
#   write  runes/agents/+/tasks/+/response       correlated replies to peers
#   write  runes/prompts/+/progress|response     work it executes
#   write  runes/prompts/response                global fan-out summary
#   + opt-in: runes/_log/#, $a2a discovery, runes/tools/+/request|response|error
#     (the request READ is a privilege: it carries RUNES_RPC_SECRET, so it
#      goes only to --tool-rpc-listener agents when that is given)
#
# FAIL CLOSED: no catch-all allow (`readwrite #`) is emitted. With an
# acl_file configured, mosquitto denies every topic that is not explicitly
# allowed here — the generated file only narrows, it never widens.
require 'optparse'
require 'fileutils'

module Runes
  module Security
    # Pure renderer for the mosquitto ACL. The CLI at the bottom is a thin
    # wrapper so tests can drive the class directly.
    class ACL
      DEFAULT_ORG = 'runes'
      DEFAULT_SHARED_GROUP = 'runes-prompts'
      # Agent ids become mosquitto usernames and MQTT topic fragments.
      SAFE_TOKEN_RE = /\A[A-Za-z0-9][A-Za-z0-9._-]*\z/
      # (access, topic) pairs; access is one of read/write/readwrite.
      TOOL_RPC_SUFFIXES = %w[request response error].freeze
      A2A_READ = '$a2a/v1/discovery/+/+/+'

      class ACLError < StandardError; end

      attr_reader :agents, :org, :shared_group, :tool_rpc_listeners

      def initialize(agents:, org: DEFAULT_ORG, shared_group: DEFAULT_SHARED_GROUP,
                     allow_journal: false, a2a: false, tool_rpc: false,
                     tool_rpc_listeners: [], fleet_grants: {}, fleet_note: nil)
        @agents = Array(agents).map { |a| a.to_s.strip }.reject(&:empty?).uniq
        raise ACLError, 'at least one --agent ID is required (fail closed)' if @agents.empty?

        @agents.each do |agent|
          unless agent.match?(SAFE_TOKEN_RE)
            raise ACLError, "invalid agent id #{agent.inspect} (expected #{SAFE_TOKEN_RE.source})"
          end
        end

        @org = validate_token(org, 'org')
        @shared_group = validate_token(shared_group, 'shared group')
        @allow_journal = allow_journal == true
        @a2a = a2a == true
        @tool_rpc = tool_rpc == true
        @tool_rpc_explicit = Array(tool_rpc_listeners).map { |a| a.to_s.strip }.reject(&:empty?).uniq
        @tool_rpc_explicit.each do |listener|
          unless @agents.include?(listener)
            raise ACLError, "tool-rpc listener #{listener.inspect} is not one of the --agent ids"
          end
        end
        # S5-4: the request topic carries the shared RPC secret, so reading
        # it is a privilege. When no listener is named we fall back to the
        # historical fleet-wide read (any agent may serve tool RPC) but say
        # so loudly in the generated file; `--tool-rpc-listener ID` narrows
        # it to the agents that actually execute tool requests.
        @tool_rpc_listeners = @tool_rpc_explicit.empty? ? @agents.dup : @tool_rpc_explicit

        # Fleet round-trip (§8.2): the fleet loader's ACL extract —
        # role => [[access, topic], ...] — merged onto the base grants.
        # Fail closed BOTH ways: every fleet role must be one of the
        # rendered agents (a grant nobody renders is a silent widening
        # waiting to happen), and every grant topic must be a safe token.
        @fleet_note = fleet_note
        @fleet_grants = fleet_grants.transform_keys(&:to_s)
        unknown = @fleet_grants.keys - @agents
        unless unknown.empty?
          raise ACLError,
                "fleet grants exist for roles that are not --agent ids: #{unknown.join(', ')} " \
                "(fleet roles and broker usernames must match)"
        end

        # Fleet grant topics are full MQTT topic strings, already
        # validated fail-closed by the fleet loader (its SAFE_TOPIC);
        # re-validating them as ACL tokens would reject every slash.
        @fleet_grants.each_value do |pairs|
          pairs.each do |access, _topic|
            unless %w[read write readwrite].include?(access.to_s)
              raise ACLError, "fleet grant access #{access.inspect} must be read/write/readwrite"
            end
          end
        end
      end

      # Every grant for one agent as [access, topic] pairs, in emission
      # order: reads, then writes, fleet-derived grants, then opt-in
      # blocks.
      def grants(agent)
        id = validate_token(agent, 'agent id')
        out = read_topics(id).map { |topic| ['read', topic] }
        out.concat(write_topics(id).map { |topic| ['write', topic] })
        out.concat(@fleet_grants.fetch(id, []))
        out << ['readwrite', 'runes/_log/#'] if @allow_journal
        out
      end

      # Flat list of [agent, access, topic].
      def granted_topics
        @agents.flat_map { |agent| grants(agent).map { |access, topic| [agent, access, topic] } }
      end

      # Topics nobody is granted: the generator's explicit default-deny
      # statement (the catch-all is NOT emitted as an allow anywhere).
      def denied_catch_all
        'readwrite #'
      end

      def render
        out = +''
        out << "# Runes MQTT ACL — generated by bin/runes-acl\n"
        out << "#\n"
        out << "#   agents:       #{@agents.join(', ')}\n"
        out << "#   org:          #{@org}\n"
        out << "#   shared-group: #{@shared_group}\n"
        out << "#   journal:      #{@allow_journal ? 'allowed (runes/_log/#)' : 'not granted'}\n"
        out << "#   a2a:          #{@a2a ? 'granted' : 'not granted'}\n"
        out << "#   tool-rpc:     #{@tool_rpc ? 'granted' : 'not granted'}\n"
        out << "#   fleet:        #{@fleet_note}\n" if @fleet_note
        if @tool_rpc
          scope = @tool_rpc_explicit.empty? ? 'ALL agents (no --tool-rpc-listener given)' \
                                            : @tool_rpc_listeners.join(', ')
          out << "#   tool-rpc read of runes/tools/+/request: #{scope}\n"
          out << "#     NOTE: the request payload carries RUNES_RPC_SECRET. Pass\n"
          out << "#     --tool-rpc-listener ID to grant that read only to the agents\n"
          out << "#     that execute tool requests.\n"
        end
        out << "#\n"
        out << "# Point mosquitto at this file (`acl_file /path/to/this/file` in\n"
        out << "# mosquitto.conf). When an acl_file is configured, mosquitto DENIES\n"
        out << "# every topic that is not explicitly allowed below: this file emits\n"
        out << "# no catch-all allow on purpose, so the default is deny.\n"
        out << "#\n"
        out << "# Usernames are the agent ids. Pair this with\n"
        out << "# Runes::Security::Credentials (RUNES_MQTT_USERNAME/PASSWORD) or\n"
        out << "# per-user password_file entries.\n"

        @agents.each do |agent|
          out << "\n# ---- agent: #{agent} ----\n"
          out << "user #{agent}\n"
          grants(agent).each { |access, topic| out << "topic #{access} #{topic}\n" }
        end

        out << "\n# Default deny: anything not listed above is refused by mosquitto.\n"
        out
      end

      # Human-readable summary of what was granted, plus the default-deny
      # statement. Used by `--print-topics`.
      def print_topics
        out = +"Granted topics (#{@agents.size} agent(s), org=#{@org}, shared-group=#{@shared_group}):\n"
        @agents.each do |agent|
          out << "\n#{agent}:\n"
          grants(agent).each { |access, topic| out << "  #{access.ljust(9)} #{topic}\n" }
        end
        out << "\nDefault deny (granted to nobody): #{denied_catch_all}\n"
        out
      end

      private

      def read_topics(id)
        topics = %W[
          runes/agents/+/card
          runes/agents/+/status
          runes/agents/#{id}/#
          runes/agents/#{id}/tasks
          runes/agents/#{id}/tasks/+/response
          runes/prompts
          $share/#{@shared_group}/runes/prompts
        ]
        topics << A2A_READ if @a2a
        if @tool_rpc
          # Callers read results from every tool's response/error channel.
          topics << 'runes/tools/+/response'
          topics << 'runes/tools/+/error'
          # Only a tool-RPC listener reads requests (they carry the secret).
          topics << 'runes/tools/+/request' if tool_rpc_listener?(id)
        end
        topics
      end

      def write_topics(id)
        topics = %W[
          runes/agents/#{id}/card
          runes/agents/#{id}/status
          runes/agents/+/tasks/+/response
          runes/prompts/+/progress
          runes/prompts/+/response
          runes/prompts/response
        ]
        topics << "$a2a/v1/discovery/#{@org}/+/#{id}" if @a2a
        if @tool_rpc
          # Every agent may call a tool; only listeners answer.
          topics << 'runes/tools/+/request'
          if tool_rpc_listener?(id)
            topics << 'runes/tools/+/response'
            topics << 'runes/tools/+/error'
          end
        end
        topics
      end

      def tool_rpc_listener?(id)
        @tool_rpc && @tool_rpc_listeners.include?(id)
      end

      def validate_token(value, label)
        token = value.to_s.strip
        unless token.match?(SAFE_TOKEN_RE)
          raise ACLError, "invalid #{label} #{value.inspect} (expected #{SAFE_TOKEN_RE.source})"
        end

        token
      end
    end
  end
end

if File.expand_path($PROGRAM_NAME) == File.expand_path(__FILE__)
  options = {
    agents: [],
    org: Runes::Security::ACL::DEFAULT_ORG,
    shared_group: Runes::Security::ACL::DEFAULT_SHARED_GROUP,
    out: nil,
    print_topics: false,
    allow_journal: false,
    a2a: false,
    tool_rpc: false,
    tool_rpc_listeners: []
  }

  parser = OptionParser.new do |o|
    o.banner = 'Usage: bin/runes-acl --agent ID [--agent ID ...] [options]'
    o.separator ''
    o.separator 'Generates a fail-closed mosquitto acl_file for the Runes topic map.'
    o.separator ''
    o.on('--agent ID', 'Agent id (repeatable, required)') { |v| options[:agents] << v }
    o.on('--org ORG', "A2A organisation (default: #{Runes::Security::ACL::DEFAULT_ORG})") { |v| options[:org] = v }
    o.on('--shared-group NAME',
         "Shared subscription group (default: #{Runes::Security::ACL::DEFAULT_SHARED_GROUP})") do |v|
      options[:shared_group] = v
    end
    o.on('--out FILE', 'Write the ACL to FILE instead of stdout') { |v| options[:out] = v }
    o.on('--print-topics', 'List the granted topics instead of the ACL') { options[:print_topics] = true }
    o.on('--allow-journal', 'Grant runes/_log/# (durable journal feed)') { options[:allow_journal] = true }
    o.on('--a2a', 'Grant the $a2a/v1/discovery topics') { options[:a2a] = true }
    o.on('--tool-rpc', 'Grant runes/tools/+/request|response|error') { options[:tool_rpc] = true }
    o.on('--tool-rpc-listener ID',
         'Agent that may READ runes/tools/+/request (repeatable; default: all agents)') do |v|
      options[:tool_rpc_listeners] << v
    end
    o.on('--fleet PATH', 'Load a .fleet.rb file: merge its ACL extract, auto-add its roles') do |v|
      options[:fleet] = v
    end
    o.on('-h', '--help', 'Show this help') do
      puts o
      exit 0
    end
  end

  begin
    parser.parse!(ARGV)

    fleet_grants = {}
    fleet_note = nil
    if options[:fleet]
      require_relative '../lib/runes/fleet'
      require_relative '../lib/runes/backends/cruby' # wire the Json/SHA256 facades
      world = Runes::Fleet.load_file(options[:fleet])
      # The fleet DECLARES these roles exist: they become first-class
      # agents in the rendered ACL (broker usernames = fleet role ids).
      options[:agents] |= world.roles.keys.map(&:to_s)
      fleet_grants = world.acl_extract
      fleet_note = "#{world.name} (digest #{world.fingerprint[0, 12]}…, roles #{world.roles.keys.join(', ')})"
    end

    acl = Runes::Security::ACL.new(
      agents: options[:agents],
      org: options[:org],
      shared_group: options[:shared_group],
      allow_journal: options[:allow_journal],
      a2a: options[:a2a],
      tool_rpc: options[:tool_rpc],
      tool_rpc_listeners: options[:tool_rpc_listeners],
      fleet_grants: fleet_grants,
      fleet_note: fleet_note
    )
  rescue OptionParser::ParseError, Runes::Security::ACL::ACLError => e
    warn "runes-acl: #{e.message}"
    warn parser
    exit 1
  end

  text = options[:print_topics] ? acl.print_topics : acl.render

  if options[:out]
    FileUtils.mkdir_p(File.dirname(File.expand_path(options[:out])))
    File.write(options[:out], text)
    warn "runes-acl: wrote #{options[:out]} (#{acl.agents.size} agent(s))"
  else
    puts text
  end
end
