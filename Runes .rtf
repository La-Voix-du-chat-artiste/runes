\f1\b0 :\
\pard\tx180\tx360\pardeftab720\li360\fi-360\partightenfactor0
\ls6\ilvl1
\fs12\fsmilli6050 \cf2 \up0 \nosupersub \ulnone {\listtext	
\f2 \uc0\u9702 
\f1 	}
\fs22 \up0 \nosupersub \ulnone Prefer request/reply and short-lived subscriptions over long-lived ones inside the sandbox.\
\ls6\ilvl1
