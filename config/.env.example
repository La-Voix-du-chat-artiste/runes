# Runes configuration template — copy to config/.env and fill in.
# NOTE: values here are loaded by Settings (NOT into the process ENV):
# provider keys never leak into run_command child shells (S-R1).
# Every RUNES_* variable below is honoured from this file, including
# RUNES_WASM / RUNES_WASM_TIMEOUT_S (B4-9) — EXCEPT the entries marked
# "process ENV only", which read ENV[...] directly (llm.rb, identity.rb,
# llm_client.rb) and must be exported rather than written here.

# --- LLM provider keys (at least one) ------------------------------------
# Preference order when more than one key is present:
#   DeepSeek (V4.1 Flash) > Synthetic (GLM) > Cerebras
# DeepSeek V4.1 Flash: https://api.deepseek.com/v1 (model `deepseek-flash`,
# thinking mode on; variation high -> reasoning_effort=high).
#DEEPSEEK=your-deepseek-key-here
# Synthetic (GLM models): https://api.synthetic.new/openai/v1
#SYNTHETIC=your-synthetic-key-here
# Cerebras (Llama): https://api.cerebras.ai/v1
#CEREBRAS_API_KEY=your-cerebras-key-here

# --- Optional overrides (defaults shown) ---
# RUNES_DEFAULT_PROVIDER=deepseek
# RUNES_DEFAULT_MODEL=deepseek-flash
# RUNES_DEFAULT_VARIATION=high
# RUNES_WORKSPACE=/absolute/path/to/workspace
# RUNES_ROOT=/absolute/path/to/project   # redirect DB/journal/docs/tools (tests/embeds)
# RUNES_POLICY=config/policy.json
# RUNES_WASM=mock                  # real enables ruby.wasm
# RUNES_MQTT_HOST=127.0.0.1
# RUNES_MQTT_PORT=1883
# RUNES_LLM_TIMEOUT_S=180
# RUNES_MAX_TOKENS=                # unset = provider default
# RUNES_WASM_TIMEOUT_S=30
# RUNES_USE_TOOLS=1                # 0 = legacy free-form JSON plans
# RUNES_MAX_STEPS=25
# RUNES_MAX_CONCURRENT=4
# RUNES_TRANSPORT=mqtt5            # auto|inproc|mqtt311|mqtt5 (mqtt5 = shared dispatch)
# RUNES_PROMPT_GROUP=runes-prompts # shared-subscription group for runes/prompts
# RUNES_REQUIRE_SHARED_SUBSCRIPTIONS=1  # refuse to start without exactly-once dispatch
# RUNES_A2A=1                     # A2A discovery + task topics (default on)
# RUNES_A2A_ORG=runes
# RUNES_A2A_UNIT=my-host
# RUNES_REQUIRE_SIGNATURES=1      # verify inbound envelopes, sign outbound delegation
# RUNES_TRUST_DIR=config/trust    # peer public keys (<agent-id>.pem)
# RUNES_LLM_ADAPTER=ruby_llm      # [process ENV only] community ruby_llm gem instead of the built-in router
# RUNES_TOOL_RPC=                  # 1 enables the tool-RPC topic (needs a secret)
# RUNES_RPC_SECRET=                # shared secret required by tool RPC requests
# RUNES_TOOL_CONCURRENT=2          # concurrent tool-RPC workers (dispatcher)
# RUNES_CMD_ALLOWLIST=             # e.g. ls,cat — interpreters are refused unless named here
# RUNES_CMD_TIMEOUT_S=10
# RUNES_CMD_OUTPUT_CAP=65536
# RUNES_MCP_TOOL_TIMEOUT_S=15      # bin/runes-mcp: manifest-tool/RPC timeout (CMD_TIMEOUT_S wins)
# RUNES_AGENT_KEY=                 # [process ENV only] PEM private key or a path to one
# RUNES_DEBUG=                     # [process ENV only] verbose LLM diagnostics on stderr
# RUNES_READ_CAP=1048576
# RUNES_WRITE_CAP=1048576
# RUNES_RETRY_BACKOFF_S=0.5        # base LLM retry backoff (0 in tests)
# RUNES_SESSION_TTL_S=1800
# RUNES_MISSION_CONTINUE=          # 1 keeps going after a failed todo
# RUNES_REDACT_PROMPTS=            # 1 redacts journal prompt text
# RUNES_ALLOW_PROVIDER_FALLBACK=   # 0 refuses cross-provider routing
